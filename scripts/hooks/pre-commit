#!/usr/bin/env bash
#
# Pre-commit gate: the whole suite must pass, and engine changes should carry
# test changes.
#
# Lives in the repo (not .git/hooks) so it is version-controlled and applies on
# every machine. Enabled with:
#
#     git config core.hooksPath scripts/hooks
#
# Bypass for a genuine emergency:  git commit --no-verify
# Use that sparingly — a gate that is routinely skipped is not a gate.
set -uo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root" || exit 1

echo "pre-commit: running test suite..."
if ! ./scripts/run_tests.sh -q; then
    cat <<'MSG'

  COMMIT BLOCKED — tests failed.

  Fix the code, or update the test if the behaviour changed deliberately.
  A test that no longer matches the code is not noise to be silenced: it is
  the only thing standing between a refactor and a live-money defect.

  Emergency bypass:  git commit --no-verify
MSG
    exit 1
fi

# --- advisory: engine changed, tests did not -------------------------------
#
# NOT a block. Plenty of engine commits legitimately touch no test — comments,
# logging, a docstring. Blocking those would train the reflex of reaching for
# --no-verify, and then the hard gate above stops being read either.
staged=$(git diff --cached --name-only --diff-filter=ACM)
engine_changed=$(echo "$staged" | grep -c '^api/engine/' || true)
tests_changed=$(echo "$staged" | grep -c '^api/tests/' || true)

if [ "$engine_changed" -gt 0 ] && [ "$tests_changed" -eq 0 ]; then
    cat <<MSG

  NOTE: $engine_changed engine file(s) staged, no test changes.

$(echo "$staged" | grep '^api/engine/' | sed 's/^/    /')

  If this changes behaviour, it wants a test. If it is comments, logging or
  naming, carry on — this is advisory only.
MSG
fi

# --- mermaid diagrams -------------------------------------------------------
#
# A broken diagram fails SILENTLY: GitHub renders the fence as an error box and
# nothing else complains, so it can sit wrong for weeks. The validator catches
# the syntax that actually breaks rendering (pipes in node labels, parens and
# slashes in edge labels, multi-colon state transitions).
#
# Scoped to staged markdown that actually contains a mermaid fence, so a commit
# touching no diagram pays nothing. Errors block; warnings are printed and
# ignored, because the checks are regex heuristics and a false positive must
# not train the --no-verify reflex.
mermaid_files=$(
    git diff --cached --name-only --diff-filter=ACM -- '*.md' \
        | while read -r f; do
            [ -f "$f" ] && grep -lq '```mermaid' "$f" && echo "$f"
          done
)

if [ -n "$mermaid_files" ]; then
    echo "pre-commit: validating mermaid in $(echo "$mermaid_files" | wc -l) file(s)..."
    # shellcheck disable=SC2086
    if ! python3 scripts/validate_mermaid.py $mermaid_files; then
        cat <<'MSG'

  COMMIT BLOCKED — a mermaid diagram will not render.

  Fix the syntax above, or if you believe the validator is wrong:
      git commit --no-verify

MSG
        exit 1
    fi
fi

# --- advisory: does this change make a diagram stale? -----------------------
#
# diagram_agent maps changed source files to the architecture-diagram sections
# they affect. It does NOT rewrite the diagram — auto-update is unimplemented
# — so this can only tell you what has drifted. Never blocks: a stale diagram
# is worth knowing about, not worth stopping a commit for.
if [ -n "$staged" ]; then
    # shellcheck disable=SC2086
    python3 scripts/diagram_agent.py $staged || true
fi

echo "pre-commit: OK"
exit 0
